# Server-only Roboflow configuration for the Realtime study.
# Keep real values in .env.local for local work and Secret Manager for Cloud Run.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_REALTIME_WORKFLOW_ID=
ROBOFLOW_IMAGE_INPUT=
ROBOFLOW_CLASSES=person
ROBOFLOW_DATA_OUTPUT=
ROBOFLOW_WEBRTC_INSIDE_LEFT_OUTPUT=
ROBOFLOW_WEBRTC_INSIDE_RIGHT_OUTPUT=
ROBOFLOW_WEBRTC_OUTSIDE_OUTPUT=
ROBOFLOW_WEBRTC_LEFT_POLYGON_INPUT=
ROBOFLOW_WEBRTC_RIGHT_POLYGON_INPUT=
ROBOFLOW_WEBRTC_PLAN=webrtc-gpu-medium
ROBOFLOW_WEBRTC_REGION=us

# Server-only Roboflow configuration for static Orchestration snapshots.
ROBOFLOW_SNAPSHOT_WORKFLOW_ID=
ROBOFLOW_SNAPSHOT_IMAGE_INPUT=image
ROBOFLOW_SNAPSHOT_POLYGON_INPUT=crosswalk_polygon
ROBOFLOW_SNAPSHOT_CLASSES_INPUT=classes
