# Server-only Roboflow configuration for the Realtime study.
# Keep real values in .env.local for local work and Secret Manager for Cloud Run.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_REALTIME_WORKFLOW_ID=
ROBOFLOW_IMAGE_INPUT=
ROBOFLOW_CLASSES=person
ROBOFLOW_DATA_OUTPUT=
ROBOFLOW_WEBRTC_PLAN=webrtc-gpu-medium
ROBOFLOW_WEBRTC_REGION=us

# Server-only HLS directory for CARLA camera 90014. Never prefix with NEXT_PUBLIC_.
CARLA_HLS_BASE_URL=http://10.150.0.2:8080/live/

# Calibration agent — only needed for the RECALIBRATE debug button in local dev.
# On Cloud Run the web app authenticates via identity tokens instead.
# CALIBRATION_AGENT_API_KEY=
